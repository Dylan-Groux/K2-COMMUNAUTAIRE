# URL de l'API si elle est servie ailleurs (défaut : /api via le proxy Vite)
VITE_API_URL=
# Lien d'invitation du serveur Discord
VITE_DISCORD_URL=https://discord.com
# ID du serveur Discord (widget activé) pour l'activité en direct sur l'accueil. Vide = données d'exemple
VITE_DISCORD_GUILD_ID=
# Endpoint du bot { window_hours, role, games: [{ name, hours, players }] }. Vide = données d'exemple
VITE_STATS_URL=
# Bot QLS (dossier K2 BOT) : remplace le widget public. Ex. http://localhost:3002/widget et http://localhost:3002/stats
VITE_WIDGET_URL=
