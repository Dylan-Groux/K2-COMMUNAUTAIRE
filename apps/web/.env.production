# Utilisé par `npm run build`. Ces valeurs sont intégrées au JS du site, donc publiques : aucun secret ici.

# API (cPanel → Setup Node.js App sur un sous-domaine). Ex. https://api.ton-domaine.fr/api
# Obligatoire : la CI refuse de construire le site si c'est vide. scripts/deploy.sh s'en sert aussi pour
# vérifier que l'API répond (<VITE_API_URL>/health) après chaque déploiement.
VITE_API_URL=https://api.qslbis.fr/api
VITE_DISCORD_URL=https://discord.gg/kAzcZ8tDpc
# Fichiers écrits chaque minute par le bot QLS dans public_html/bot (EXPORT_DIR du bot).
VITE_WIDGET_URL=/bot/widget.json
VITE_STATS_URL=/bot/stats.json
